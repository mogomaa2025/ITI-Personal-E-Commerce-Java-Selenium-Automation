{
    "valid": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "123456789",
        "address": "alexandria egypt"
    },
   "shortPassword": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "123",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "Please lengthen this text to 6 characters or more"
    },
    "emptyPassword": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "Please fill out this field"
    },
    "passwordWithoutNumber": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "$Zm@gomaa",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "Password must contain at least one number"
    },
    "emptyName": {
        "name": "",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "Please fill out this field"
    },
    "shortName": {
        "name": "go",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "Name must be at least 3 characters long"
    },
    "existingEmail": {
        "name": "test test",
        "email": "test@test.test",
        "password": "test@123",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "User already exists"
    },
    "noAtEmail": {
        "name": "test test",
        "email": "testtest.test",
        "password": "test@123",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "missing an '@'"
    },
    "symbolsNotAtEmail": {
        "name": "test test",
        "email": "user#@#!#!@#$!@$%!%@@test.com",
        "password": "test@123",
        "phone": "123456789",
        "address": "alexandria egypt",
        "expectedMessage": "should not contain the symbol"
    },
    "emptyPhone": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "",
        "address": "alexandria egypt",
        "expectedMessage": "Phone number is required"
    },
    "shortPhone": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "1234567",
        "address": "alexandria egypt",
        "expectedMessage": "Phone number must be between 8 and 20 characters"
    },
    "strangeSymbolPhone": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "#01028838444",
        "address": "alexandria egypt",
        "expectedMessage": "Phone number must contain only numbers and +"
    },
    "emptyAddress": {
        "name": "test test",
        "email": "@gmail.com",
        "password": "test@123",
        "phone": "123456789",
        "address": "",
        "expectedMessage": "Address is required"
    }
}